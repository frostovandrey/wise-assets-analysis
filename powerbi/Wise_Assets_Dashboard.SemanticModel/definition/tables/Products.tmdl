		source =
				DATATABLE(
				    "Product", STRING,
				    "Sort Order", INTEGER,
				    {
				        {"Direct debit", 1},
				        {"Account details", 2},
				        {"Card", 3},
				        {"Sent money abroad", 4}
				    }
				)

	annotation PBI_Id = 5b99388ac9ab45a8803511a9c0b32a26

