	column Product
		dataType: string
		lineageTag: 1a5807eb-0973-4310-ad87-2b12e15ec4ac
		summarizeBy: none
		isNameInferred
		sourceColumn: [Product]
		sortByColumn: 'Sort Order'

		annotation SummarizationSetBy = Automatic

	column 'Sort Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 28276991-50c0-4c1e-8e04-73bb8a341128
		summarizeBy: none
		isNameInferred
		sourceColumn: [Sort Order]

		annotation SummarizationSetBy = Automatic

	partition Products = calculated
